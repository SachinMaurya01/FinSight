#
# Complex values (lists) are parsed as JSON, e.g.:
#   FALLBACK_CHAIN=["openai","gemini"]
# Nested settings use a double-underscore delimiter, e.g.:
#   MODEL_ROUTING__CHEAP__MODEL_NAME=gpt-4o-mini

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Provider credentials (env-injected at runtime) ---
OPENAI_API_KEY=your-openai-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b
GOOGLE_API_KEY=your-google-gemini-key-here
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your-vllm-key-here
VLLM_MODEL=your-local-model-name

# --- Model routing tiers — ChatGPT (OpenAI) as default, Groq as fallback ---
# Cheap / simple queries -> fast & cheap
MODEL_ROUTING__CHEAP__MODEL_NAME=gpt-4o-mini
MODEL_ROUTING__CHEAP__PROVIDER=openai
# Normal queries -> balanced
MODEL_ROUTING__MEDIUM__MODEL_NAME=gpt-4o
MODEL_ROUTING__MEDIUM__PROVIDER=openai
# Complex queries -> most capable
MODEL_ROUTING__EXPENSIVE__MODEL_NAME=gpt-4-turbo
MODEL_ROUTING__EXPENSIVE__PROVIDER=openai
# Groq fallback examples (used when OpenAI fails/timeout/rate-limit):
#   MODEL_ROUTING__CHEAP__MODEL_NAME=qwen/qwen3.6-27b      (provider=groq)
#   MODEL_ROUTING__MEDIUM__MODEL_NAME=qwen/qwen3.6-27b     (provider=groq)
#   MODEL_ROUTING__EXPENSIVE__MODEL_NAME=openai/gpt-oss-120b (provider=groq)

# --- Fallback chain: ChatGPT (OpenAI) -> Groq -> Gemini -> vLLM ---
FALLBACK_CHAIN=["openai","groq","gemini","vllm"]

# --- Embeddings ---
# Default: local sentence-transformers model (no API key, offline).
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
# Alternative: OpenAI embeddings (requires OPENAI_API_KEY, 1536 dims):
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Hybrid retrieval ---
DENSE_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=20
RERANK_TOP_K=8
RRF_K=60
DENSE_WEIGHT=0.6
LEXICAL_WEIGHT=0.4

# --- Context compression ---
CONTEXT_TOKEN_BUDGET=12000
MAX_COMPRESSED_CHUNKS=8

# --- Citation verification (bounded retry per PRD §3.2) ---
VERIFICATION_MAX_RETRIES=2

# --- Human-in-the-loop ---
HITL_ENABLED=true

# --- Tools ---
ENABLE_TOOLS=true

# --- Redis / LangGraph checkpointer ---
REDIS_URL=redis://localhost:6379/0
CHECKPOINTER_TYPE=in_memory

# --- Postgres + pgvector ---
POSTGRES_DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db

# --- SEC EDGAR (User-Agent must contain a contact email) ---
SEC_EDGAR_USER_AGENT=FinSightResearch dev@example.com
SEC_REQUEST_THROTTLE_SECONDS=0.5

# --- Evaluation ---
EVAL_DATASET_PATH=data/eval/eval_dataset.json
RAGAS_METRICS=["context_precision","context_recall","faithfulness","answer_relevance"]
JUDGE_MODEL=qwen/qwen3.6-27b
EVAL_SEED=42
